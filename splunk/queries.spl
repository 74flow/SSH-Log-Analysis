# 1. Validate event types
index=ssh_logs
| stats count by event_type

# 2. Top 10 source IPs with failed logins
index=ssh_logs event_type="Failed SSH Login"
| stats count AS failed_attempts by id.orig_h
| sort - failed_attempts
| head 10

# 3. Repeated failed authentication attempts
index=ssh_logs event_type="Multiple Failed Authentication Attempts"
| stats max(auth_attempts) AS attempts count by id.orig_h id.resp_h
| where attempts > 5 OR attempts > 5
| sort - attempts

# 4. Successful logins by source and destination
index=ssh_logs event_type="Successful SSH Login"
| stats count AS successful_logins by id.orig_h id.resp_h
| sort - successful_logins

# 5. Connections without authentication over time
index=ssh_logs event_type="Connection Without Authentication"
| timechart span=5m count by id.orig_h
